# DeamOS — standard edition, NVIDIA (deamos-standard-nvidia)
#
# Same as standard, but FROM Universal Blue's aurora-nvidia-OPEN: NVIDIA's
# open-source GPU kernel modules (Turing / RTX 20-series and newer). We use the
# open variant deliberately — it is freely redistributable (the proprietary
# aurora-nvidia image is access-gated) and fits our open-source positioning.
# It cannot FROM deamos-base (that's the non-NVIDIA branch), so it re-applies the
# shared rebrand + branding + AI stack + agent.

# --- Stage 1: compile deamos-agentd -------------------------------------------
FROM docker.io/library/rust:1-bookworm AS agent-builder
RUN apt-get update && apt-get install -y --no-install-recommends cmake clang \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY agent /src/agent
RUN cd agent && cargo build --release -p deamos-agentd

# --- Stage 2: the image -----------------------------------------------------
FROM ghcr.io/ublue-os/aurora-nvidia-open:stable

# Rebrand + branding (same scripts/assets as deamos-base).
COPY recipes/modules/rebrand.sh /tmp/rebrand.sh
RUN bash /tmp/rebrand.sh && rm -f /tmp/rebrand.sh

# First-boot account/language wizard (no lockout).
COPY recipes/modules/initial-setup/install.sh /tmp/initial-setup.sh
RUN bash /tmp/initial-setup.sh && rm -f /tmp/initial-setup.sh

COPY assets/wallpapers/Deamos /usr/share/wallpapers/Deamos
COPY assets/logo.svg /usr/share/pixmaps/deamos-logo.svg
COPY recipes/base/skel/plasma-org.kde.plasma.desktop-appletsrc \
     /etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc
COPY recipes/base/skel/kscreenlockerrc /etc/skel/.config/kscreenlockerrc

# First-login welcome: familiar desktop ergonomics by prior OS.
COPY recipes/modules/ergonomics/apply-preset.sh   /usr/libexec/deamos/apply-preset.sh
COPY recipes/modules/ergonomics/layout-windows.js /usr/libexec/deamos/layout-windows.js
COPY recipes/modules/ergonomics/layout-macos.js   /usr/libexec/deamos/layout-macos.js
COPY recipes/modules/ergonomics/layout-gnome.js   /usr/libexec/deamos/layout-gnome.js
COPY recipes/modules/welcome/deamos-welcome.sh    /usr/libexec/deamos/deamos-welcome.sh
COPY recipes/modules/welcome/deamos-welcome.desktop /etc/xdg/autostart/deamos-welcome.desktop
RUN chmod +x /usr/libexec/deamos/apply-preset.sh /usr/libexec/deamos/deamos-welcome.sh

# AI stack (Ollama systemd service).
COPY recipes/modules/ai-stack/install.sh /tmp/ai-stack.sh
RUN bash /tmp/ai-stack.sh && rm -f /tmp/ai-stack.sh

# Deamos Agent: binary + user service (auto-start) + safe default config.
COPY --from=agent-builder /src/agent/target/release/deamos-agentd /usr/bin/deamos-agentd
COPY recipes/modules/deamos-agent/deamos-agentd.service /usr/lib/systemd/user/deamos-agentd.service
COPY recipes/modules/deamos-agent/agent.toml /etc/deamos/agent.toml
RUN systemctl --global enable deamos-agentd.service

# First-boot setup (A-M3): recommend + pull a model sized to the machine.
COPY recipes/modules/firstboot/deamos-firstboot.sh /usr/bin/deamos-firstboot
COPY recipes/modules/firstboot/deamos-firstboot.service /usr/lib/systemd/user/deamos-firstboot.service
RUN chmod +x /usr/bin/deamos-firstboot && systemctl --global enable deamos-firstboot.service

# Omnibox: kdialog prompt -> /agent, launchable and bound to Meta+A.
COPY recipes/modules/omnibox/deamos-omnibox.sh /usr/bin/deamos-omnibox
COPY recipes/modules/omnibox/deamos-omnibox.desktop /usr/share/applications/deamos-omnibox.desktop
COPY recipes/modules/omnibox/kglobalshortcutsrc /etc/skel/.config/kglobalshortcutsrc
RUN chmod +x /usr/bin/deamos-omnibox

RUN sed -i 's/^DEAMOS_EDITION=.*/DEAMOS_EDITION="standard-nvidia"/' /usr/lib/os-release

# --- Build-time sanity ------------------------------------------------------
RUN grep -q 'DeamOS' /usr/lib/os-release && \
    command -v ollama && command -v deamos-agentd && \
    test -f /usr/lib/systemd/user/deamos-agentd.service && \
    test -x /usr/bin/deamos-firstboot && \
    test -x /usr/bin/deamos-omnibox && \
    test -x /usr/libexec/deamos/apply-preset.sh && \
    test -x /usr/libexec/deamos/deamos-welcome.sh && \
    test -f /usr/lib/systemd/system/initial-setup.service && \
    test -f /etc/deamos/agent.toml
