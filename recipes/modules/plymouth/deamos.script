# DeamOS Plymouth boot splash (script module) — minimalist.
#
# A single spinning ring on a black background. No background image. Clean and
# fast, like a modern OS throbber.
#
# CRITICAL: also implements the password / question / message callbacks. On a
# LUKS-encrypted install Plymouth shows the disk-unlock prompt through these —
# without them the user cannot type their passphrase and is locked out at boot.
# Verify the unlock prompt in a VM before shipping.

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Pure black background.
Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

# ---- Spinning ring ----------------------------------------------------------
ring_image = Image("ring.png");
spinner = Sprite();
spinner.SetZ(50);

angle = 0;
fun refresh_callback() {
    angle = angle + 0.15;            # radians per refresh (~ smooth spin)
    if (angle > 6.2831853) { angle = angle - 6.2831853; }
    rotated = ring_image.Rotate(angle);
    spinner.SetImage(rotated);
    # Rotation can change the bounding box; recentre every frame.
    spinner.SetX((screen_width  - rotated.GetWidth())  / 2);
    spinner.SetY((screen_height - rotated.GetHeight()) / 2);
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- Status / boot message --------------------------------------------------
message_sprite = Sprite();
fun display_message_callback(text) {
    my_image = Image.Text(text, 0.85, 0.9, 1);
    message_sprite.SetImage(my_image);
    message_sprite.SetX((screen_width - my_image.GetWidth()) / 2);
    message_sprite.SetY(screen_height * 0.78);
    message_sprite.SetZ(60);
}
fun hide_message_callback() {
    message_sprite.SetImage(Image.Text("", 1, 1, 1));
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

# ---- Password prompt (LUKS unlock) — MUST stay, or boot locks out -----------
prompt_sprite = Sprite();
bullets_sprite = Sprite();
fun display_password_callback(prompt, bullets) {
    prompt_image = Image.Text(prompt, 0.9, 0.95, 1);
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetX((screen_width - prompt_image.GetWidth()) / 2);
    prompt_sprite.SetY(screen_height * 0.80);
    prompt_sprite.SetZ(70);

    dots = "";
    i = 0;
    while (i < bullets) { dots = dots + "*"; i++; }
    bullets_image = Image.Text(dots, 0.9, 0.95, 1);
    bullets_sprite.SetImage(bullets_image);
    bullets_sprite.SetX((screen_width - bullets_image.GetWidth()) / 2);
    bullets_sprite.SetY(screen_height * 0.84);
    bullets_sprite.SetZ(70);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# ---- Question prompt --------------------------------------------------------
question_sprite = Sprite();
answer_sprite = Sprite();
fun display_question_callback(prompt, entry) {
    q_image = Image.Text(prompt, 0.9, 0.95, 1);
    question_sprite.SetImage(q_image);
    question_sprite.SetX((screen_width - q_image.GetWidth()) / 2);
    question_sprite.SetY(screen_height * 0.80);
    question_sprite.SetZ(70);

    a_image = Image.Text(entry, 0.9, 0.95, 1);
    answer_sprite.SetImage(a_image);
    answer_sprite.SetX((screen_width - a_image.GetWidth()) / 2);
    answer_sprite.SetY(screen_height * 0.84);
    answer_sprite.SetZ(70);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

# ---- Return to normal (clear prompts) ---------------------------------------
fun display_normal_callback() {
    prompt_sprite.SetImage(Image.Text("", 1, 1, 1));
    bullets_sprite.SetImage(Image.Text("", 1, 1, 1));
    question_sprite.SetImage(Image.Text("", 1, 1, 1));
    answer_sprite.SetImage(Image.Text("", 1, 1, 1));
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
