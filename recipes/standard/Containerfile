# DeamOS — standard edition (deamos-standard)
#
# deamos-base + local AI stack (Ollama) + Deamos Agent. The default desktop edition.
# For NVIDIA, see recipes/standard-nvidia/.

# --- Stage 1: compile deamos-agentd -------------------------------------------
FROM docker.io/library/rust:1-bookworm AS agent-builder
# cmake/clang for the rustls crypto provider (aws-lc-rs) build.
RUN apt-get update && apt-get install -y --no-install-recommends cmake clang \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY agent /src/agent
RUN cd agent && cargo build --release -p deamos-agentd

# --- Stage 2: the image -----------------------------------------------------
# Base is built by the build-image workflow's `base` job into this repo owner's
# GHCR (works both on agent4bnk-spec and groupplaton-design).
FROM ghcr.io/groupplaton-design/deamos-base:latest

# AI stack (Ollama systemd service).
COPY recipes/modules/ai-stack/install.sh /tmp/ai-stack.sh
RUN bash /tmp/ai-stack.sh && rm -f /tmp/ai-stack.sh

# Deamos Agent: binary + user service (auto-start) + safe default config.
COPY --from=agent-builder /src/agent/target/release/deamos-agentd /usr/bin/deamos-agentd
COPY recipes/modules/deamos-agent/deamos-agentd.service /usr/lib/systemd/user/deamos-agentd.service
COPY recipes/modules/deamos-agent/agent.toml /etc/deamos/agent.toml
RUN systemctl --global enable deamos-agentd.service

# First-boot setup (A-M3): recommend + pull a model sized to the machine.
COPY recipes/modules/firstboot/deamos-firstboot.sh /usr/bin/deamos-firstboot
COPY recipes/modules/firstboot/deamos-firstboot.service /usr/lib/systemd/user/deamos-firstboot.service
RUN chmod +x /usr/bin/deamos-firstboot && systemctl --global enable deamos-firstboot.service

# Omnibox: kdialog prompt -> /agent, launchable (KRunner/menu) and bound to
# Meta+A for new users.
COPY recipes/modules/omnibox/deamos-omnibox.sh /usr/bin/deamos-omnibox
COPY recipes/modules/omnibox/deamos-omnibox.desktop /usr/share/applications/deamos-omnibox.desktop
COPY recipes/modules/omnibox/kglobalshortcutsrc /etc/skel/.config/kglobalshortcutsrc
# Also drop the AI launcher onto every new user's Desktop so it is always
# visible (no hunting for it). Marked executable so Plasma launches it without
# the "untrusted desktop file" prompt.
RUN mkdir -p /etc/skel/Desktop \
    && cp /usr/share/applications/deamos-omnibox.desktop /etc/skel/Desktop/deamos-omnibox.desktop \
    && chmod +x /usr/bin/deamos-omnibox /etc/skel/Desktop/deamos-omnibox.desktop

# Mark the edition.
RUN sed -i 's/^DEAMOS_EDITION=.*/DEAMOS_EDITION="standard"/' /usr/lib/os-release

# --- Build-time sanity ------------------------------------------------------
RUN command -v ollama && command -v deamos-agentd && \
    test -f /usr/lib/systemd/system/ollama.service && \
    test -f /usr/lib/systemd/user/deamos-agentd.service && \
    test -x /usr/bin/deamos-firstboot && \
    test -x /usr/bin/deamos-omnibox && \
    test -f /etc/deamos/agent.toml
