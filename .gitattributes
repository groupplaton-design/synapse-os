# Normalize line endings. The repo targets Linux; these files MUST stay LF or
# they break at runtime (a CRLF shebang -> "bad interpreter", broken Plymouth
# scripts, etc.). This holds regardless of a contributor's core.autocrlf.
* text=auto eol=lf

# Belt-and-suspenders: force LF for everything that runs/parses on Linux.
*.sh        text eol=lf
*.bash      text eol=lf
*.js        text eol=lf
*.toml      text eol=lf
*.service   text eol=lf
*.desktop   text eol=lf
*.colors    text eol=lf
*.plymouth  text eol=lf
*.script    text eol=lf
*.rs        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
Containerfile text eol=lf
justfile    text eol=lf

# Binary assets — never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.svg  text eol=lf
*.iso  binary
*.webp binary
